# user config and local state (keep the example in git)
beeagent.json
.beeagent/
.pytest_cache/
site/
space_shooter.py
-p

# a shell redirect typed as `> nul` instead of `> /dev/null` writes the device
# name into the working tree on Windows — ping output sitting in the repo root,
# untracked and, until this line, not ignored
nul

# scratch artifacts a run leaves in whatever folder it started from: the
# `diagram` tool's SVG output (big.svg, diagram.svg appeared here on 2026-09-24)
# and the side file every guarded write goes through (`<target>.beecode-tmp`,
# beeagent/tools/base.py)
*.svg
!docs/**/*.svg
*.beecode-tmp

# save_config writes beside the target and moves it in; a save killed halfway also
# leaves the unreadable original set aside. Neither is anybody's config file.
beeagent.json.*.tmp
beeagent.json.broken
beeagent.json.broken.*

# local working notes, not part of the release
docs/superpowers/

# the pool server is the operator's own box: it holds the keys, so it stays out
# of the public repository entirely
/server/

# the key pool keeps its credentials and its ledger here; neither belongs in git
keys.json
pool.db
pool.db-shm
pool.db-wal
